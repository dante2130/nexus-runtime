{
  "name": "decky-nexus-achievements",
  "version": "0.2.5",
  "description": "Achievement notifications for Nexus runtime games on Steam Deck.",
  "type": "module",
  "scripts": {
    "test:filters": "node --test tests/achievement-filters.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:cache": "node --test tests/cache.test.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test:audio": "node --test tests/notification-audio.test.mjs",
    "test:icons": "node --test tests/achievement-icons.test.mjs",
    "test:built-icons": "node --test tests/compiled-icons.test.mjs",
    "test:header": "node --test tests/game-header-entries.test.mjs",
    "test:status-navigation": "node --test tests/profile-status-navigation.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  }
}
